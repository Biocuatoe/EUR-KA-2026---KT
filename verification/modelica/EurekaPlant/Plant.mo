within EurekaPlant;
model Plant "Corrected longitudinal plant, forward form (specification: verification/modelica-plant-specification.md)"
  extends Parameters;
  // run configuration
  parameter Real v_init(unit = "m/s") = 0 "initial speed";
  parameter Real T_init(unit = "N.m") = 0 "initial delivered torque";
  parameter Real V1_init(unit = "V") = 0 "initial RC-branch voltage";
  parameter Real SoC_init(unit = "1") = 0.8 "initial state of charge";
  parameter Real eps_w(unit = "1/s") = 1e-6 "floor on motor speed inside P_max/omega";
  // derived parameters
  final parameter Real M_eff(unit = "kg") = M + J_m*G^2/r_w^2 "effective mass";
  final parameter Real gr(unit = "1/m") = G/r_w "motor speed per vehicle speed";
  final parameter Real R0(unit = "Ohm") = R0_new*(1 + k_r0*(1 - SoH));
  final parameter Real R1(unit = "Ohm") = R1_new*(1 + k_r1*(1 - SoH));
  // input (prescribed by a test model)
  Real T_ref(unit = "N.m") "torque request";
  // states
  Real v(unit = "m/s", start = v_init, fixed = true);
  Real T(unit = "N.m", start = T_init, fixed = true);
  Real V1(unit = "V", start = V1_init, fixed = true);
  Real SoC(unit = "1", start = SoC_init, fixed = true);
  Real E_chem(unit = "J", start = 0, fixed = true);
  Real E_rr(unit = "J", start = 0, fixed = true);
  Real E_aero(unit = "J", start = 0, fixed = true);
  Real E_fb(unit = "J", start = 0, fixed = true);
  Real E_gear(unit = "J", start = 0, fixed = true);
  Real E_visc(unit = "J", start = 0, fixed = true);
  Real E_mi(unit = "J", start = 0, fixed = true);
  Real E_R0(unit = "J", start = 0, fixed = true);
  Real E_R1(unit = "J", start = 0, fixed = true);
  Real E_regen(unit = "J", start = 0, fixed = true);
  Real dist(unit = "m", start = 0, fixed = true);
  Real Ah(unit = "A.h", start = 0, fixed = true);
  // algebraic quantities
  Real vp(unit = "m/s") "speed used in all force and power terms, max(v, 0)";
  Real omega(unit = "1/s") "motor speed";
  Real T_lim(unit = "N.m");
  Real T_cmd(unit = "N.m");
  Real t_s(unit = "N.m") "shaft torque into the gearbox";
  Real F_w(unit = "N") "traction force at the wheels";
  Real sm(unit = "1") "tanh smoothing of the sign of the speed";
  Real F_rr(unit = "N");
  Real F_aero(unit = "N");
  Real F_fb(unit = "N");
  Real F_net(unit = "N");
  Real a(unit = "m/s2") "acceleration";
  Real dTdt(unit = "N.m/s");
  Real P_m(unit = "W");
  Real P_e(unit = "W");
  Real Vo(unit = "V");
  Real disc(unit = "V2");
  Real I(unit = "A") "battery current, positive on discharge";
  Real KE(unit = "J");
  Real closure(unit = "J") "supplied energy minus all sinks (must be about 0)";
equation
  vp = max(v, 0);
  omega = gr*vp;
  T_lim = min(T_max, P_max/max(omega, eps_w));
  T_cmd = min(max(T_ref, -T_lim), T_lim);
  t_s = T - B_m*omega;
  F_w = if t_s >= 0 then gr*eta_g*t_s else gr*t_s/eta_g;
  sm = tanh(vp/v_eps);
  F_rr = C_rr*M*g*sm;
  F_aero = 0.5*rho*C_d*A_f*vp*abs(vp);
  F_fb = gr*max(0, -T_lim - T_ref)*sm;
  F_net = F_w - F_rr - F_aero - F_fb;
  der(v) = if v <= 0 and F_net < 0 then 0 else F_net/M_eff;
  a = der(v);
  der(T) = (T_cmd - T)/tau_T;
  dTdt = der(T);
  P_m = T*omega;
  P_e = if P_m >= 0 then P_m/eta_mi else P_m*eta_mi;
  Vo = V_oc - V1;
  disc = Vo^2 - 4*R0*P_e;
  assert(disc >= 0, "battery power infeasible: no real current solution");
  I = (Vo - sqrt(max(disc, 0)))/(2*R0);
  der(V1) = -V1/(R1*C1) + I/C1;
  der(SoC) = -I/(3600*Q_Ah*SoH);
  der(E_chem) = V_oc*I;
  der(E_rr) = F_rr*vp;
  der(E_aero) = F_aero*vp;
  der(E_fb) = F_fb*vp;
  der(E_gear) = t_s*omega - F_w*vp;
  der(E_visc) = B_m*omega^2;
  der(E_mi) = P_e - P_m;
  der(E_R0) = R0*I^2;
  der(E_R1) = V1^2/R1;
  der(E_regen) = min(P_e, 0);
  der(dist) = vp;
  der(Ah) = abs(I)/3600;
  KE = 0.5*M_eff*v^2;
  closure = E_chem - (KE - 0.5*M_eff*v_init^2 + 0.5*C1*(V1^2 - V1_init^2) + E_rr + E_aero + E_fb + E_gear + E_visc + E_mi + E_R0 + E_R1);
end Plant;
