within EurekaPlant;
model InverseTracking "Ideal tracking: the speed follows a piecewise-linear reference exactly; torque, power and current follow from the inverse of the force balance"
  extends Parameters;
  parameter Integer n = 1 "number of segments";
  parameter Integer kind[n] = {1};
  parameter Real p[n] = {1.0};
  parameter Real target[n] = {0.0};
  final parameter Real M_eff(unit = "kg") = M + J_m*G^2/r_w^2;
  final parameter Real gr(unit = "1/m") = G/r_w;
  final parameter Real R0(unit = "Ohm") = R0_new*(1 + k_r0*(1 - SoH));
  final parameter Real R1(unit = "Ohm") = R1_new*(1 + k_r1*(1 - SoH));
  parameter Real tk[n + 1] = Profiles.knotTimes(n, kind, p, target) "knot times";
  parameter Real vk[n + 1] = Profiles.knotSpeeds(n, kind, p, target) "knot speeds";
  Integer seg "current segment: 1 + number of interior knots already passed (time events at the knots)";
  Real v_ref(unit = "m/s");
  Real a_ref(unit = "m/s2");
  Real V1(unit = "V", start = 0, fixed = true);
  Real E_chem(unit = "J", start = 0, fixed = true);
  Real E_rr(unit = "J", start = 0, fixed = true);
  Real E_aero(unit = "J", start = 0, fixed = true);
  Real E_gear(unit = "J", start = 0, fixed = true);
  Real E_visc(unit = "J", start = 0, fixed = true);
  Real E_mi(unit = "J", start = 0, fixed = true);
  Real E_R0(unit = "J", start = 0, fixed = true);
  Real E_R1(unit = "J", start = 0, fixed = true);
  Real dist(unit = "m", start = 0, fixed = true);
  Real omega(unit = "1/s");
  Real F_rr(unit = "N");
  Real F_aero(unit = "N");
  Real F_req(unit = "N") "required traction force";
  Real t_s(unit = "N.m");
  Real T(unit = "N.m") "required (= delivered) motor torque";
  Real T_lim(unit = "N.m");
  Real limit_margin(unit = "N.m") "T_lim - |T|; must stay positive, otherwise the ideal trace is infeasible";
  Real P_m(unit = "W");
  Real P_e(unit = "W");
  Real disc(unit = "V2");
  Real I(unit = "A");
  Real KE(unit = "J");
  Real closure(unit = "J");
  Real Wh_per_km "(E_chem/3600)/(dist/1000), valid once dist > 0";
equation
  seg = 1 + sum(if time >= tk[i] then 1 else 0 for i in 2:n);
  a_ref = (vk[seg + 1] - vk[seg])/(tk[seg + 1] - tk[seg]);
  v_ref = vk[seg] + a_ref*(time - tk[seg]);
  omega = gr*v_ref;
  F_rr = C_rr*M*g*tanh(v_ref/v_eps);
  F_aero = 0.5*rho*C_d*A_f*v_ref*abs(v_ref);
  F_req = M_eff*a_ref + F_rr + F_aero;
  t_s = if F_req >= 0 then F_req/(gr*eta_g) else F_req*eta_g/gr;
  T = t_s + B_m*omega;
  T_lim = min(T_max, P_max/max(omega, 1e-6));
  limit_margin = T_lim - abs(T);
  P_m = T*omega;
  P_e = if P_m >= 0 then P_m/eta_mi else P_m*eta_mi;
  disc = (V_oc - V1)^2 - 4*R0*P_e;
  assert(disc >= 0, "battery power infeasible");
  I = ((V_oc - V1) - sqrt(max(disc, 0)))/(2*R0);
  der(V1) = -V1/(R1*C1) + I/C1;
  der(E_chem) = V_oc*I;
  der(E_rr) = F_rr*v_ref;
  der(E_aero) = F_aero*v_ref;
  der(E_gear) = t_s*omega - F_req*v_ref;
  der(E_visc) = B_m*omega^2;
  der(E_mi) = P_e - P_m;
  der(E_R0) = R0*I^2;
  der(E_R1) = V1^2/R1;
  der(dist) = v_ref;
  KE = 0.5*M_eff*v_ref^2;
  closure = E_chem - (KE + 0.5*C1*V1^2 + E_rr + E_aero + E_gear + E_visc + E_mi + E_R0 + E_R1);
  Wh_per_km = if dist > 0 then E_chem/3600/(dist/1000) else 0;
end InverseTracking;
