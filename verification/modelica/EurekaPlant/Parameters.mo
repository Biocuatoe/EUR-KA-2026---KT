within EurekaPlant;
model Parameters "GENERATED by verification/scripts/generate_modelica_inputs.py from configs/parameters.yaml. Do not edit by hand."
  parameter Real M(unit = "kg") = 850.0 "vehicle.mass; provenance: report_unverified";
  parameter Real A_f(unit = "m2") = 2.2 "vehicle.frontal_area; provenance: report_unverified";
  parameter Real C_d(unit = "1") = 0.35 "vehicle.drag_coefficient; provenance: report_unverified";
  parameter Real C_rr(unit = "1") = 0.008 "vehicle.rolling_resistance; provenance: report_unverified";
  parameter Real r_w(unit = "m") = 0.28 "vehicle.wheel_radius; provenance: report_unverified";
  parameter Real rho(unit = "kg/m3") = 1.225 "vehicle.air_density; provenance: standard";
  parameter Real g(unit = "m/s2") = 9.81 "vehicle.gravity; provenance: standard";
  parameter Real G(unit = "1") = 6.5 "drivetrain.gear_ratio; provenance: report_unverified";
  parameter Real eta_g(unit = "1") = 0.9702 "drivetrain.gear_efficiency; provenance: report_unverified";
  parameter Real J_m(unit = "kg.m2") = 0.05 "drivetrain.motor_inertia; provenance: report_unverified";
  parameter Real B_m(unit = "N.m.s") = 0.001 "drivetrain.motor_viscous_friction; provenance: report_unverified";
  parameter Real eta_mi(unit = "1") = 0.874 "drivetrain.motor_inverter_efficiency; provenance: report_unverified";
  parameter Real T_max(unit = "N.m") = 85.0 "drivetrain.torque_max; provenance: report_unverified";
  parameter Real P_max(unit = "W") = 18000.0 "drivetrain.power_max; provenance: report_unverified";
  parameter Real tau_T(unit = "s") = 0.02 "drivetrain.torque_time_constant; provenance: assumed";
  parameter Real V_oc(unit = "V") = 48.0 "battery.open_circuit_voltage; provenance: assumed";
  parameter Real Q_Ah(unit = "A.h") = 100.0 "battery.capacity; provenance: report_unverified";
  parameter Real R0_new(unit = "Ohm") = 0.005 "battery.r0_new; provenance: report_unverified";
  parameter Real R1_new(unit = "Ohm") = 0.003 "battery.r1_new; provenance: report_unverified";
  parameter Real C1(unit = "F") = 50000.0 "battery.c1; provenance: report_unverified";
  parameter Real k_r0(unit = "1") = 0.5 "battery.k_r0; provenance: report_unverified";
  parameter Real k_r1(unit = "1") = 0.3 "battery.k_r1; provenance: report_unverified";
  parameter Real v_eps(unit = "m/s") = 0.05 "simulation.speed_smoothing; provenance: assumed";
  parameter Real SoH(unit = "1") = 1.0 "run property (not in the YAML): battery state of health, constant within a run";
end Parameters;
