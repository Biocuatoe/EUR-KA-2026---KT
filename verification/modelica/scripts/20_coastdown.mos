loadFile("../modelica/EurekaPlant/package.mo"); getErrorString();
loadFile("../openmodelica-smoke/CoastDown.mo"); getErrorString();
loadFile("../modelica/negative_fixtures/NegativeFixtures.mo"); getErrorString();
mkdir("cases"); getErrorString();
mkdir("cases/C1_toy_linear_drag"); cd("cases/C1_toy_linear_drag");
simulate(CoastDown, startTime = 0, stopTime = 20.0, numberOfIntervals = 2000, tolerance = 1e-10, method = "dassl", outputFormat = "csv", fileNamePrefix = "C1_toy_linear_drag", simflags = ""); getErrorString();
cd("../..");
mkdir("cases/C2_project_tol1e-06"); cd("cases/C2_project_tol1e-06");
simulate(EurekaPlant.Tests.CoastDown, startTime = 0, stopTime = 20.0, numberOfIntervals = 2000, tolerance = 1e-06, method = "dassl", outputFormat = "csv", fileNamePrefix = "C2_project_tol1e-06", variableFilter = "^(time|v|omega|F_w|F_rr|F_aero|F_net|a|T|closure)$", simflags = ""); getErrorString();
cd("../..");
mkdir("cases/C2_project_tol1e-08"); cd("cases/C2_project_tol1e-08");
simulate(EurekaPlant.Tests.CoastDown, startTime = 0, stopTime = 20.0, numberOfIntervals = 2000, tolerance = 1e-08, method = "dassl", outputFormat = "csv", fileNamePrefix = "C2_project_tol1e-08", variableFilter = "^(time|v|omega|F_w|F_rr|F_aero|F_net|a|T|closure)$", simflags = ""); getErrorString();
cd("../..");
mkdir("cases/C2_project_tol1e-10"); cd("cases/C2_project_tol1e-10");
simulate(EurekaPlant.Tests.CoastDown, startTime = 0, stopTime = 20.0, numberOfIntervals = 2000, tolerance = 1e-10, method = "dassl", outputFormat = "csv", fileNamePrefix = "C2_project_tol1e-10", variableFilter = "^(time|v|omega|F_w|F_rr|F_aero|F_net|a|T|closure)$", simflags = ""); getErrorString();
cd("../..");
mkdir("cases/C2_project_tol1e-12"); cd("cases/C2_project_tol1e-12");
simulate(EurekaPlant.Tests.CoastDown, startTime = 0, stopTime = 20.0, numberOfIntervals = 2000, tolerance = 1e-12, method = "dassl", outputFormat = "csv", fileNamePrefix = "C2_project_tol1e-12", variableFilter = "^(time|v|omega|F_w|F_rr|F_aero|F_net|a|T|closure)$", simflags = ""); getErrorString();
cd("../..");
mkdir("cases/E_C2_wrong_branch_fixture"); cd("cases/E_C2_wrong_branch_fixture");
simulate(NegCoastDownWrongBranch, startTime = 0, stopTime = 20.0, numberOfIntervals = 2000, tolerance = 1e-10, method = "dassl", outputFormat = "csv", fileNamePrefix = "E_C2_wrong_branch_fixture", simflags = ""); getErrorString();
cd("../..");
mkdir("cases/E_C2_Crr_plus1pct"); cd("cases/E_C2_Crr_plus1pct");
simulate(EurekaPlant.Tests.CoastDown, startTime = 0, stopTime = 20.0, numberOfIntervals = 2000, tolerance = 1e-10, method = "dassl", outputFormat = "csv", fileNamePrefix = "E_C2_Crr_plus1pct", variableFilter = "^(time|v)$", simflags = "-override=C_rr=0.00808"); getErrorString();
cd("../..");
