loadFile("../modelica/EurekaPlant/package.mo"); getErrorString();
mkdir("cases"); getErrorString();
mkdir("cases/F1_openloop66_tol1e-08"); cd("cases/F1_openloop66_tol1e-08");
simulate(EurekaPlant.Tests.OpenLoop66, startTime = 0, stopTime = 66.0, numberOfIntervals = 6600, tolerance = 1e-08, method = "dassl", outputFormat = "csv", fileNamePrefix = "F1_openloop66_tol1e-08", simflags = ""); getErrorString();
cd("../..");
mkdir("cases/F1_openloop66_tol1e-10"); cd("cases/F1_openloop66_tol1e-10");
simulate(EurekaPlant.Tests.OpenLoop66, startTime = 0, stopTime = 66.0, numberOfIntervals = 6600, tolerance = 1e-10, method = "dassl", outputFormat = "csv", fileNamePrefix = "F1_openloop66_tol1e-10", simflags = "-lv=LOG_STATS"); getErrorString();
cd("../..");
mkdir("cases/F1_openloop66_tol1e-12"); cd("cases/F1_openloop66_tol1e-12");
simulate(EurekaPlant.Tests.OpenLoop66, startTime = 0, stopTime = 66.0, numberOfIntervals = 6600, tolerance = 1e-12, method = "dassl", outputFormat = "csv", fileNamePrefix = "F1_openloop66_tol1e-12", simflags = ""); getErrorString();
cd("../..");
mkdir("cases/E_F1_openloop66_Crr_plus1pct"); cd("cases/E_F1_openloop66_Crr_plus1pct");
simulate(EurekaPlant.Tests.OpenLoop66, startTime = 0, stopTime = 66.0, numberOfIntervals = 6600, tolerance = 1e-10, method = "dassl", outputFormat = "csv", fileNamePrefix = "E_F1_openloop66_Crr_plus1pct", simflags = "-override=C_rr=0.00808"); getErrorString();
cd("../..");
