loadFile("../modelica/EurekaPlant/package.mo"); getErrorString();
mkdir("cases"); getErrorString();
mkdir("cases/DIAG_dassl_tol1e-11"); cd("cases/DIAG_dassl_tol1e-11");
simulate(EurekaPlant.Tests.OpenLoop66, startTime = 0, stopTime = 66.0, numberOfIntervals = 6600, tolerance = 1e-11, method = "dassl", outputFormat = "csv", fileNamePrefix = "DIAG_dassl_tol1e-11", variableFilter = "^(time|v|T|E_chem|closure)$"); getErrorString();
cd("../..");
