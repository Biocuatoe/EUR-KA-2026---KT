loadFile("../modelica/EurekaPlant/package.mo"); getErrorString();
mkdir("cases"); getErrorString();
mkdir("cases/B1_eq_20kmh"); cd("cases/B1_eq_20kmh");
simulate(EurekaPlant.Tests.StaticPoint, startTime = 0, stopTime = 1.0, numberOfIntervals = 100, tolerance = 1e-10, method = "dassl", outputFormat = "csv", fileNamePrefix = "B1_eq_20kmh", simflags = "-override=v_init=5.555555555555555,T_init=3.737107988033914,T_hold=3.737107988033914"); getErrorString();
cd("../..");
mkdir("cases/B1_eq_30kmh"); cd("cases/B1_eq_30kmh");
