# EUREKA 2026 project environment variables (single source of truth).
# Read by scripts/activate.ps1, scripts/setup.ps1, scripts/verify.ps1 and by
# VS Code via "python.envFile". Process-scoped only: nothing here is written to
# the user or machine environment. Keep values ASCII, unquoted, one per line.

EUREKA_ROOT=D:\EUREKA-2026

# uv: project venv outside repo\, managed Python and cache under the project root
UV_PROJECT_ENVIRONMENT=D:\EUREKA-2026\.venv
UV_CACHE_DIR=D:\EUREKA-2026\cache\uv
UV_PYTHON_INSTALL_DIR=D:\EUREKA-2026\tools\python
UV_PYTHON_PREFERENCE=only-managed
UV_PYTHON_DOWNLOADS=manual

# pip (overrides the user-level PIP_CACHE_DIR=D:\AI\Cache\Pip for this project)
PIP_CACHE_DIR=D:\EUREKA-2026\cache\pip

# Matplotlib config + font cache (default would be %USERPROFILE%\.matplotlib)
MPLCONFIGDIR=D:\EUREKA-2026\cache\matplotlib

# Jupyter / IPython (defaults would be under %USERPROFILE% and %APPDATA%)
JUPYTER_PLATFORM_DIRS=1
JUPYTER_CONFIG_DIR=D:\EUREKA-2026\tools\jupyter\config
JUPYTER_DATA_DIR=D:\EUREKA-2026\tools\jupyter\data
JUPYTER_RUNTIME_DIR=D:\EUREKA-2026\cache\jupyter\runtime
IPYTHONDIR=D:\EUREKA-2026\cache\ipython

# Tool caches that would otherwise land in the current directory
RUFF_CACHE_DIR=D:\EUREKA-2026\cache\ruff
COVERAGE_FILE=D:\EUREKA-2026\cache\coverage\.coverage
HYPOTHESIS_STORAGE_DIRECTORY=D:\EUREKA-2026\cache\hypothesis

# Temporary files (pytest tmp_path, pip build dirs, tempfile) - C: is nearly full
TEMP=D:\EUREKA-2026\cache\tmp
TMP=D:\EUREKA-2026\cache\tmp
