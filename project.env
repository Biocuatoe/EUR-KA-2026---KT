# EUREKA 2026 project environment variables (single source of truth).
# Read by scripts/activate.ps1, scripts/setup.ps1, scripts/verify.ps1 and by
# VS Code via "python.envFile". Process-scoped only: nothing here is written to
# the user or machine environment. Saved as UTF-8 without BOM (the project root
# contains a non-ASCII letter; scripts/_common.ps1 reads it as UTF-8). Values
# unquoted, one per line.

EUREKA_ROOT=D:\EURÉKA 2026 - KT

# uv: project venv, managed Python and cache under the project root
UV_PROJECT_ENVIRONMENT=D:\EURÉKA 2026 - KT\.venv
UV_CACHE_DIR=D:\EURÉKA 2026 - KT\cache\uv
UV_PYTHON_INSTALL_DIR=D:\EURÉKA 2026 - KT\tools\python
UV_PYTHON_PREFERENCE=only-managed
UV_PYTHON_DOWNLOADS=manual

# pip (overrides the user-level PIP_CACHE_DIR=D:\AI\Cache\Pip for this project)
PIP_CACHE_DIR=D:\EURÉKA 2026 - KT\cache\pip

# Matplotlib config + font cache (default would be %USERPROFILE%\.matplotlib)
MPLCONFIGDIR=D:\EURÉKA 2026 - KT\cache\matplotlib

# Jupyter / IPython (defaults would be under %USERPROFILE% and %APPDATA%)
JUPYTER_PLATFORM_DIRS=1
JUPYTER_CONFIG_DIR=D:\EURÉKA 2026 - KT\tools\jupyter\config
JUPYTER_DATA_DIR=D:\EURÉKA 2026 - KT\tools\jupyter\data
JUPYTER_RUNTIME_DIR=D:\EURÉKA 2026 - KT\cache\jupyter\runtime
IPYTHONDIR=D:\EURÉKA 2026 - KT\cache\ipython

# Tool caches that would otherwise land in the current directory
RUFF_CACHE_DIR=D:\EURÉKA 2026 - KT\cache\ruff
COVERAGE_FILE=D:\EURÉKA 2026 - KT\cache\coverage\.coverage
HYPOTHESIS_STORAGE_DIRECTORY=D:\EURÉKA 2026 - KT\cache\hypothesis

# Temporary files (pytest tmp_path, pip build dirs, tempfile) - C: is nearly full
TEMP=D:\EURÉKA 2026 - KT\cache\tmp
TMP=D:\EURÉKA 2026 - KT\cache\tmp
